<style>
:root{--navy:#14213d;--blue:#2457c5;--gold:#fca311;--bg:#f4f7fb;--ink:#172033;--muted:#64748b;--white:#fff}
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}
.hero{background:linear-gradient(125deg,#14213d,#2457c5);color:white;padding:30px 18px 36px}
.project{text-align:center;max-width:1100px;margin:auto}
.college{font-size:clamp(18px,3vw,25px);font-weight:800;letter-spacing:.4px;margin-bottom:9px}
.project h1{font-size:clamp(25px,5vw,42px);margin:8px 0}
.project p{margin:7px 0;color:#e5edff}
.student{display:inline-block;margin-top:12px;padding:9px 16px;border:1px solid #ffffff70;border-radius:30px;background:#ffffff12}
.wrap{max-width:1150px;margin:24px auto;padding:0 16px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px}
.stat{background:white;border-radius:14px;padding:15px;text-align:center;box-shadow:0 3px 14px #1720330c}
.stat strong{display:block;font-size:25px;color:var(--blue)}.stat span{font-size:13px;color:var(--muted)}
.controls{display:grid;grid-template-columns:1.6fr 1fr auto;gap:10px;margin:18px 0}
input,select{width:100%;padding:13px 14px;border:1px solid #d5ddeb;border-radius:10px;font-size:15px;background:white;color:var(--ink)}
button{border:0;border-radius:10px;padding:12px 16px;background:var(--blue);color:white;font-weight:700;cursor:pointer}
button:hover,.link:hover{filter:brightness(.93)}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0 22px}
.toolbar button{background:#e7edfb;color:#173b88}.toolbar .primary{background:var(--blue);color:white}
.section-title{font-size:21px;margin:24px 0 12px;color:var(--navy)}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
.card{background:white;border:1px solid #e4eaf3;border-radius:14px;padding:17px;box-shadow:0 3px 12px #17203308}
.card h3{font-size:17px;margin:0 0 9px;color:#18366f}
.category{font-size:11px;font-weight:800;letter-spacing:.5px;color:#2457c5;background:#edf2ff;padding:5px 8px;border-radius:20px;display:inline-block;margin-bottom:10px}
.card p{font-size:14px;line-height:1.55;color:#475569;margin:0 0 14px}
.link{display:inline-block;background:#2457c5;color:white;text-decoration:none;padding:9px 12px;border-radius:8px;font-size:13px;font-weight:700}
.empty{background:white;padding:25px;border-radius:12px;text-align:center;color:var(--muted);grid-column:1/-1}
.note{font-size:12px;color:#64748b;line-height:1.5;margin:22px 0}
footer{text-align:center;background:#14213d;color:#dbe5ff;padding:18px;font-size:13px}
@media(max-width:700px){.controls{grid-template-columns:1fr}.grid{grid-template-columns:1fr}.stats{gap:7px}.stat{padding:12px 5px}.stat strong{font-size:21px}}
</style>
</head>
